{
  "name": "react-example",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server:dev": "tsx watch --ignore .sandbox --ignore dist server/start.ts",
    "server:start": "tsx server/start.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "node -e \"for (const dir of ['dist','dist-electron','release']) require('fs').rmSync(dir, { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:main": "set NODE_OPTIONS=--import tsx && electron electron/main.ts",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:3000 && set ELECTRON_RENDERER_URL=http://127.0.0.1:3000 && set NODE_OPTIONS=--import tsx && electron electron/main.ts\"",
    "electron:bundle": "npm run build && node ./node_modules/esbuild/bin/esbuild electron/main.ts electron/preload.ts --bundle --platform=node --format=cjs --outdir=dist-electron --out-extension:.js=.cjs --external:electron --external:better-sqlite3",
    "electron:build": "npm run electron:bundle && electron-builder --config electron-builder.yml --win nsis",
    "desktop:dist": "npm run electron:build",
    "desktop:release": "npm run electron:build && node ./scripts/buildPortableRelease.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.8.0",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.0.0",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.0.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.14.0",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.5",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.4"
  }
}
